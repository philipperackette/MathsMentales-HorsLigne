{
    "title":"Opposé d'une expression littérale (supprimer les parenthèses)",
    "description":"Trouver l'opposé d'une expression algébrique entre parenthèses.",
    "type":"latex",
    "ID":"3ND3",
    "dest":["3ND","2N3"],
    "valueType":"expressionSimplifiee",
    "textSize":"medium",
    "keys":["-","+","a","b","c","x","y","z"],
    "consts":{"lettres":["a","b","c","x","y","z"]},
    "consigne":"Développer et réduire",
    "options":[{
        "name":"Opposé d'une expression",
        "vars":{"a":"-9_9_2_^0","l":"0_5","x":"${:lettres[:l]}","posx":"0_1","s":"${:a[0]+:a[1]}","sx":"${:a[:posx]}"},
        "question": "-(${(:posx==0)?MMmath.signIfOne(:a[0])+:x::a[0]}${(:posx==1)?MMmath.signedNumberButOne(:a[1])+:x:MMmath.signedNumber(:a[1])})",
        "answer":":question=\\color{red}{${(:posx==0)?MMmath.signIfOne(-:a[0])+:x:-:a[0]}${(:posx==1)?MMmath.signedNumberButOne(-:a[1])+:x:MMmath.signedNumber(-:a[1])}}",
        "value":"${(:posx==0)?MMmath.signIfOne(-:a[0])+:x:-:a[0]}${(:posx==1)?MMmath.signedNumberButOne(-:a[1])+:x:MMmath.signedNumber(-:a[1])}"
    },{
        "name":"Supprimer les parenthèses(1)",
        "vars":{"a":"-9_9_3_^0","l":"0_5","x":"${:lettres[:l]}","posx":"1_2","s":"${:a[0]+:a[1]+:a[2]}","sx":"${:a[0]+:a[:posx]}","smx":"${:a[0]-:a[:posx]}"},
        "question":["${MMmath.signIfOne(:a[0])}${:x}-(${(:posx==1)?MMmath.signIfOne(:a[1])+:x::a[1]}${(:posx==2)?MMmath.signedNumberButOne(:a[2])+:x:MMmath.signedNumber(:a[2])})","${MMmath.signIfOne(:a[0])}${:x}+(${(:posx==1)?MMmath.signIfOne(:a[1])+:x::a[1]}${(:posx==2)?MMmath.signedNumberButOne(:a[2])+:x:MMmath.signedNumber(:a[2])})"],
        "answer":[":question=\\color{red}{${MMmath.signIfOne(:a[0])}${:x}${(:posx==1)?MMmath.signedNumberButOne(-:a[1])+:x:MMmath.signedNumber(-:a[1])}${(:posx==2)?MMmath.signedNumberButOne(-:a[2])+:x:MMmath.signedNumber(-:a[2])}}=\\color{green}{${:smx!=0?MMmath.signIfOne(:smx)+:x:''}${MMmath.signedNumber(-:a[:posx==1?2:1])}}",
        ":question=\\color{red}{${MMmath.signIfOne(:a[0])}${:x}${(:posx==1)?MMmath.signedNumberButOne(:a[1])+:x:MMmath.signedNumber(:a[1])}${(:posx==2)?MMmath.signedNumberButOne(:a[2])+:x:MMmath.signedNumber(:a[2])}}=\\color{green}{${:sx!=0?MMmath.signIfOne(:sx)+:x:''}${MMmath.signedNumber(:a[:posx==1?2:1])}}"],
        "value":["${:smx!=0?MMmath.signIfOne(:smx)+:x:''}${MMmath.signedNumber(-:a[:posx==1?2:1])}",
            "${:sx!=0?MMmath.signIfOne(:sx)+:x:''}${MMmath.signedNumber(:a[:posx==1?2:1])}"]
    },{
        "name":"Supprimer les parenthèses(2)",
        "vars":{"a":"-9_9_4_^0","l":"0_5","x":"${:lettres[:l]}", "cmx":"${:a[0]-:a[2]}", "cpx":"${-:a[0]+:a[2]}","cmmx":"${-:a[0]-:a[2]}","cm":"${:a[1]-:a[3]}", "cp":"${-:a[1]+:a[3]}","cmm":"${-:a[1]-:a[3]}"},
        "question":[
            "(${MMmath.signIfOne(:a[0])+:x+MMmath.signedNumber(:a[1])})-(${MMmath.signIfOne(:a[2])+:x+MMmath.signedNumber(:a[3])})",
            "-(${MMmath.signIfOne(:a[0])+:x+MMmath.signedNumber(:a[1])})+(${MMmath.signIfOne(:a[2])+:x+MMmath.signedNumber(:a[3])})",
            "-(${MMmath.signIfOne(:a[0])+:x+MMmath.signedNumber(:a[1])})-(${MMmath.signIfOne(:a[2])+:x+MMmath.signedNumber(:a[3])})"
        ],
        "answer":[
            ":question=\\color{red}{${MMmath.signIfOne(:a[0])+:x+MMmath.signedNumber(:a[1])+MMmath.signedNumberButOne(-:a[2])+:x+MMmath.signedNumber(-:a[3])}}=\\color{green}{${:cmx!=0?MMmath.signIfOne(:cmx)+:x:''}${:cm!==0?(:cmx!=0?MMmath.signedNumber(:cm)::cm):''}}",
            ":question=\\color{red}{${MMmath.signIfOne(-:a[0])+:x+MMmath.signedNumber(-:a[1])+MMmath.signedNumberButOne(:a[2])+:x+MMmath.signedNumber(:a[3])}}=\\color{green}{${:cpx!=0?MMmath.signIfOne(:cpx)+:x:''}${:cp!==0?(:cpx!=0?MMmath.signedNumber(:cp)::cp):''}}",
            ":question=\\color{red}{${MMmath.signIfOne(-:a[0])+:x+MMmath.signedNumber(-:a[1])+MMmath.signedNumberButOne(-:a[2])+:x+MMmath.signedNumber(-:a[3])}}=\\color{green}{${:cmmx!=0?MMmath.signIfOne(:cmmx)+:x:''}${:cmm!==0?(:cmmx!=0?MMmath.signedNumber(:cmm)::cmm):''}}"
        ],
        "value":[
            "${:cmx!=0?MMmath.signIfOne(:cmx)+:x:''}${:cm!==0?(:cmx!=0?MMmath.signedNumber(:cm)::cm):''}",
            "${:cpx!=0?MMmath.signIfOne(:cpx)+:x:''}${:cp!==0?(:cpx!=0?MMmath.signedNumber(:cp)::cp):''}",
            "${:cmmx!=0?MMmath.signIfOne(:cmmx)+:x:''}${:cmm!==0?(:cmmx!=0?MMmath.signedNumber(:cmm)::cmm):''}"
        ]
    }
    ]
}
