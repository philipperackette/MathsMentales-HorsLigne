        "answer":"(${MMmath.signIfOne(:a)+:x}${MMmath.signedNumber(:b)})(${MMmath.signIfOne(:c)+:x}${MMmath.signedNumber(:d)})=\\color{red}{${MMmath.signIfOne(:a*:c)+:x}^2${(:a*:d+:b*:c!=0)?MMmath.signedNumberButOne(:a*:d+:b*:c)+:x:''}${MMmath.signedNumber(:b*:d)}}",
        "value":"${MMmath.signIfOne(:a*:c)+:x}^2${(:a*:d+:b*:c!=0)?MMmath.signedNumberButOne(:a*:d+:b*:c)+:x:''}${MMmath.signedNumber(:b*:d)}"
    }
