        "question":"\\dfrac{${:nums[0]}}{${:den}}+\\dfrac{${:nums[1]}}{${:den}}",
        "audio":"(${:nums[0]} ${:aud}) + (${:nums[1]} ${:aud})",
        "answer":":question = \\color{red}{\\dfrac{${:nums[0]+:nums[1]}}{${:den}}}${MMmath.fractionEstSimplifiable(:nums[0]+:nums[1],:den)?'='+MMmath.fractionSimplifiee(:nums[0]+:nums[1],:den):''}",
        "value":"\\dfrac{${:nums[0]+:nums[1]}}{${:den}}"
    },{
        "name":"Ajouter des fractions de même dénominateur (6e)",
